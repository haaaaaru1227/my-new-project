<!DOCTYPE html>
<html lang="ja">
<head>
  <title>ヘアカウンセリング診断</title>
  <meta charset="utf-8">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag 'diagnostic_test/woman', media: 'all' %>
 
</head>
<body>
  <main>
    <div class="choose_box">
      <div class="app-theme">
        <h1>あなたの髪の長さを選んでください</h1>
      </div>

      <!-- 髪の長さ選択 -->
      <div class="hair-length-selection">
        <p>髪の長さを選んでください:</p>
        <a class="btn" href="<%= url_for(controller: 'diagnostic_test', action: 'style', hair_length: 'long') %>">ロング</a>
        <a class="btn" href="<%= url_for(controller: 'diagnostic_test', action: 'style', hair_length: 'bob') %>">ボブ</a>
        <a class="btn" href="<%= url_for(controller: 'diagnostic_test', action: 'style', hair_length: 'short') %>">ショート</a>
      </div>
    </div>
  </main>
</body>
</html>
