<!DOCTYPE html>
<html lang="ja">
<head>
  <title>質問に答えてください</title>
  <meta charset="utf-8">
  <%= csrf_meta_tags %>
  
  <%= javascript_include_tag 'diagnostic_test' %>
  <%= stylesheet_link_tag 'diagnostic_test/show_questions', media: 'all' %>
</head>
<body>
  <main>
    <div id="surveyContainer"> <!-- フォームの代わりにdivを使用 -->
      <h1>当てはまる方を選択してください！</h1>
      <div id="question-box">
        <% @questions.each_with_index do |question, index| %>
          <div class="question" id="<%= question[:id] %>" <% if index != 0 %>style="display: none;"<% end %>>
            <p><%= question[:text] %></p>
            <ul>
              <% question[:options].each do |option| %>
                <li>
                  <button type="button" class="btn" data-question-id="<%= question[:id] %>" data-answer="<%= option[:text] %>" data-group="<%= option[:group] %>">
                    <%= option[:text] %>
                  </button>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  </main>


</body>
</html>
